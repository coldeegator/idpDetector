{
  "manifest_version": 3,
  "name": "IdP Detector",
  "version": "0.1.0",
  "description": "Passively identifies which identity provider (Okta, Auth0, Ping, Entra, Keycloak, ...) a site's login flow uses.",
  "permissions": ["webRequest", "webNavigation", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "IdP Detector", "default_popup": "src/popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/main-world.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
